{
  "name": "BlogFront",
  "version": "0.0.1",
  "description": "My GitHub blog front",
  "main": "",
  "scripts": {
    "dev": "vite",
    "vite-build": "vite build",
    "shadow-cljs": "clj -A:shadow-cljs",
    "start": "TMUX= tmux -f '' -S /tmp/BlogFront-tmux.sock new-session \\; split-window -h \\; select-pane -t %0 \\; send-keys C-m \\; send-keys 'pnpm dev' C-m \\; select-pane -t %1 \\; send-keys 'pnpm shadow-cljs watch browser -A:nrepl' C-m",
    "build": "pnpm shadow-cljs release browser && pnpm vite-build",
    "p": "./configs/publish.sh"
  },
  "githubBlogRepo": "bolasblack/bolasblack.github.com",
  "keywords": [],
  "author": "c4605 <bolasblack@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "create-react-class": "^15.7.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-footnote": "^4.0.0",
    "normalize.css": "^8.0.1",
    "octokat": "^0.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "js-yaml": "^4.1.1",
    "sass": "^1.97.1",
    "shadow-cljs": "^2.28.23",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
